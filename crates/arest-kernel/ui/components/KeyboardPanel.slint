// crates/arest-kernel/ui/components/KeyboardPanel.slint
//
// Reusable on-screen QWERTY panel (#598, extracted from the former
// fullscreen `Keyboard` Window of #465 Track QQQQ).
//
// The original virtual keyboard was a self-contained `Window` the
// launcher swapped to, which meant the user could never see the
// keyboard and the REPL prompt at the same time — typing was blind.
// Per #598 the layout is now a plain component that docks INSIDE a
// host surface (UnifiedRepl's right pane), matching the mobile/touch
// convention of a keyboard sliding up from the bottom of the active
// screen. The host wires `key-pressed(string)` to the same
// `arch::uefi::keyboard::push_keystroke` glue the Window used, so
// every ring consumer keeps working unchanged.
//
// # Layout
//
// QWERTY hardcoded (same baseline the Window shipped). Three modes
// (letters / numbers / symbols) toggled via the bottom mode row;
// Shift toggles letter case. Mode and shift are pure UI state local
// to this component — the host never needs to know.
//
// Cells are sized by `key-size` (default 44px: compact enough that
// the panel plus the prompt plus scrollback fit a 800px-tall pane,
// still finger-sized on touch hardware). The former fullscreen
// Window used 56px cells inside a 360px band; hosts that want that
// density can set `key-size: 56px`.
//
// # Callback contract
//
// `key-pressed(string)` fires once per tap. The payload is the
// canonical Unicode codepoint the key represents (e.g. "a", "A"
// under Shift, " " for Space, "\u{0008}" Backspace, "\u{0009}" Tab,
// "\u{000A}" Enter). Exactly the contract the former Window exposed;
// the Rust glue decodes `chars().next()` and pushes
// `DecodedKey::Unicode(c)` onto the kernel keyboard ring.

import { Theme } from "../theme.slint";

// One key cell. Renders as a flat surface with the key's display
// label centred; a tap fires `pressed(codepoint-or-label)` so the
// parent can dispatch. Not the shared `Button` component: that one
// is sized for prose labels; keyboard keys want uniform cells so the
// rows align even when labels differ ("Q" vs "Shift" vs "Space").
component Key inherits Rectangle {
    in property <string> label;
    // Optional alternate codepoint dispatched on tap — when set,
    // overrides the visible label. Used for special keys whose
    // display ("Bksp", "Enter", "Space") differs from the codepoint
    // they emit ("\u{0008}", "\u{000A}", " ").
    in property <string> codepoint;
    // Base cell size, driven by the panel's `key-size`.
    in property <length> cell: 44px;
    // Highlight when this is an active modifier (Shift, mode toggle).
    in property <bool> active: false;

    callback pressed(string);

    background: active ? Theme.accent : Theme.neutral-100;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;
    min-height: cell;
    min-width: cell;

    states [
        pressed when touch.pressed : {
            background: Theme.accent.darker(0.12);
        }
        hovered when touch.has-hover : {
            background: active ? Theme.accent.darker(0.06) : Theme.neutral-200;
        }
    ]

    animate background { duration: Theme.motion-fast; easing: ease-in-out; }

    Text {
        text: label;
        color: active ? Theme.surface : Theme.text-primary;
        font-family: Theme.type-button.family;
        font-weight: Theme.type-button.weight;
        font-size: Theme.type-button.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        // `clicked` (press + release inside) rather than pointer-down:
        // press-and-drag-off cancels, matching the Button component's
        // semantics and platform expectations for a virtual keyboard.
        clicked => {
            root.pressed(root.codepoint != "" ? root.codepoint : root.label);
        }
        mouse-cursor: MouseCursor.pointer;
    }
}

// Which key set is currently rendered. Pure UI state.
enum KeyMode { letters, numbers, symbols }

export component KeyboardPanel inherits Rectangle {
    // Base key cell size — see the sizing note in the header.
    in property <length> key-size: 44px;

    // Fires once per key tap with the codepoint string. The host
    // routes it to `arch::uefi::keyboard::push_keystroke`.
    callback key-pressed(string);

    // Local mode state. `letters` is the default; Shift toggles case
    // within letters; numbers / symbols are separate sub-pages.
    property <KeyMode> mode: KeyMode.letters;
    property <bool> shift: false;

    background: Theme.neutral-100;

    // 1px top border so the docked panel reads as a distinct band.
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.spacing-sm;
        spacing: Theme.spacing-xs;
        alignment: center;

        // Letters mode: standard QWERTY rows.
        if root.mode == KeyMode.letters : VerticalLayout {
            spacing: Theme.spacing-xs;
            alignment: center;

            // Row 1: Q W E R T Y U I O P
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: root.shift ? "Q" : "q"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "W" : "w"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "E" : "e"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "R" : "r"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "T" : "t"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "Y" : "y"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "U" : "u"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "I" : "i"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "O" : "o"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "P" : "p"; pressed(s) => { root.key-pressed(s); } }
            }

            // Row 2: A S D F G H J K L
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: root.shift ? "A" : "a"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "S" : "s"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "D" : "d"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "F" : "f"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "G" : "g"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "H" : "h"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "J" : "j"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "K" : "k"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "L" : "l"; pressed(s) => { root.key-pressed(s); } }
            }

            // Row 3: Shift Z X C V B N M Bksp
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key {
                    cell: root.key-size;
                    label: "Shift";
                    active: root.shift;
                    min-width: root.key-size * 1.5;
                    pressed(s) => { root.shift = !root.shift; }
                }
                Key { cell: root.key-size; label: root.shift ? "Z" : "z"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "X" : "x"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "C" : "c"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "V" : "v"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "B" : "b"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "N" : "n"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: root.shift ? "M" : "m"; pressed(s) => { root.key-pressed(s); } }
                Key {
                    cell: root.key-size;
                    label: "Bksp";
                    // U+0008 — what the pc-keyboard US-104 decoder
                    // emits for Backspace; matches Slint Key::Backspace.
                    codepoint: "\u{0008}";
                    min-width: root.key-size * 1.5;
                    pressed(s) => { root.key-pressed(s); }
                }
            }
        }

        // Numbers mode: 0-9 plus common punctuation.
        if root.mode == KeyMode.numbers : VerticalLayout {
            spacing: Theme.spacing-xs;
            alignment: center;

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: "1"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "2"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "3"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "4"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "5"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "6"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "7"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "8"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "9"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "0"; pressed(s) => { root.key-pressed(s); } }
            }

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: "-"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "/"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: ":"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: ";"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "("; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: ")"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "$"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "&"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "@"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "\""; pressed(s) => { root.key-pressed(s); } }
            }

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: "."; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: ","; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "?"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "!"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "'"; pressed(s) => { root.key-pressed(s); } }
                Key {
                    cell: root.key-size;
                    label: "Bksp";
                    codepoint: "\u{0008}";
                    min-width: root.key-size * 1.5;
                    pressed(s) => { root.key-pressed(s); }
                }
            }
        }

        // Symbols mode: less-common punctuation + brackets.
        if root.mode == KeyMode.symbols : VerticalLayout {
            spacing: Theme.spacing-xs;
            alignment: center;

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: "["; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "]"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "{"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "}"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "#"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "%"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "^"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "*"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "+"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "="; pressed(s) => { root.key-pressed(s); } }
            }

            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Key { cell: root.key-size; label: "_"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "\\"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "|"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "~"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "<"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: ">"; pressed(s) => { root.key-pressed(s); } }
                Key { cell: root.key-size; label: "`"; pressed(s) => { root.key-pressed(s); } }
                Key {
                    cell: root.key-size;
                    label: "Bksp";
                    codepoint: "\u{0008}";
                    min-width: root.key-size * 1.5;
                    pressed(s) => { root.key-pressed(s); }
                }
            }
        }

        // Bottom row: mode toggles + Tab + Space + Enter. Always
        // visible regardless of mode.
        HorizontalLayout {
            spacing: Theme.spacing-xs;
            alignment: center;
            Key {
                cell: root.key-size;
                label: "abc";
                active: root.mode == KeyMode.letters;
                min-width: root.key-size * 1.5;
                pressed(s) => { root.mode = KeyMode.letters; }
            }
            Key {
                cell: root.key-size;
                label: "123";
                active: root.mode == KeyMode.numbers;
                min-width: root.key-size * 1.5;
                pressed(s) => { root.mode = KeyMode.numbers; }
            }
            Key {
                cell: root.key-size;
                label: "#+=";
                active: root.mode == KeyMode.symbols;
                min-width: root.key-size * 1.5;
                pressed(s) => { root.mode = KeyMode.symbols; }
            }
            Key {
                cell: root.key-size;
                label: "Tab";
                // U+0009 — Slint Key::Tab per slint_input.rs mapping.
                codepoint: "\u{0009}";
                pressed(s) => { root.key-pressed(s); }
            }
            Key {
                cell: root.key-size;
                label: "Space";
                codepoint: " ";
                min-width: root.key-size * 5;
                pressed(s) => { root.key-pressed(s); }
            }
            Key {
                cell: root.key-size;
                label: "Enter";
                // U+000A — Slint Key::Return per slint_input.rs mapping.
                codepoint: "\u{000A}";
                min-width: root.key-size * 2;
                pressed(s) => { root.key-pressed(s); }
            }
        }
    }
}
