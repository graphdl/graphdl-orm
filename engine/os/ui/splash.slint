// The full target's splash: the first TEXT on bare firmware. Glyphs
// embed at build time (slint-build, EmbedForSoftwareRenderer); the
// version strings arrive as properties — never hard-coded.
export component Splash inherits Window {
    in property <string> os-version: "";
    in property <string> engine-version: "";
    background: #101828;
    Rectangle {
        x: 40px; y: 40px;
        width: parent.width - 80px;
        height: parent.height - 80px;
        background: @linear-gradient(135deg, #c41f3a 0%, #101840 100%);
        border-radius: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: "AREST OS";
                color: white;
                font-size: 56px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.os-version;
                color: #e8e8f0;
                font-size: 22px;
                horizontal-alignment: center;
            }
            Text {
                text: root.engine-version;
                color: #c8c8d8;
                font-size: 18px;
                horizontal-alignment: center;
            }
        }
    }
}
