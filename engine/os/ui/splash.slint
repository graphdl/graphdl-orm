// The full target's home: the canon DETAIL tree of a real entity —
// the fourth realization of the same trees tk, WPF, and the react
// Tree render. Glyphs embed at build time (slint-build,
// EmbedForSoftwareRenderer); versions and the tree arrive as
// properties — never hard-coded.
export struct FieldRow {
    k: string,
    v: string,
}

export component Splash inherits Window {
    in property <string> os-version: "";
    in property <string> engine-version: "";
    in property <string> master-title: "";
    in property <[string]> items: [];
    in property <string> detail-title: "";
    in property <[FieldRow]> fields: [];
    background: #101828;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 16px;
            Text {
                text: "AREST OS";
                color: white;
                font-size: 30px;
                font-weight: 700;
            }
            Text {
                text: root.os-version + "  ·  " + root.engine-version;
                color: #8890a8;
                font-size: 14px;
                vertical-alignment: bottom;
            }
        }
        // the pane pair — the same master/detail split the desktops
        // render from the same trees (showui's SPLIT layout)
        HorizontalLayout {
            spacing: 18px;
            Rectangle {
                width: 34%;
                background: #182038;
                border-radius: 14px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Text {
                        text: root.master-title;
                        color: #e0b8c0;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    for it in root.items: Rectangle {
                        height: 44px;
                        background: #223054;
                        border-radius: 8px;
                        Text {
                            x: 14px;
                            text: it;
                            color: white;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle {
                background: @linear-gradient(135deg, #c41f3a 0%, #101840 100%);
                border-radius: 14px;
                VerticalLayout {
                    padding: 28px;
                    spacing: 10px;
                    Text {
                        text: root.detail-title;
                        color: white;
                        font-size: 24px;
                        font-weight: 600;
                    }
                    for f in root.fields: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: f.k;
                            color: #e0b8c0;
                            font-size: 16px;
                            width: 200px;
                        }
                        Text {
                            text: f.v;
                            color: white;
                            font-size: 16px;
                        }
                    }
                }
            }
        }
    }
}
