                         N(1)),
                      A("apndl"), N(2))),
                A("theta:append_phi")),
             A("system:cls_closure"))))),

DEF("system:cls_candidates",
    S3(A("COMP"), A("theta:setminus"),
       S3(A("CONS"),
          S3(A("COMP"), A("theta:setminus"),
             S3(A("CONS"),
                S3(A("COMP"), A("apply"),
                   S3(A("CONS"),
                      S3(A("COMP"), A("apply"),
                         S3(A("CONS"), K(A("theta:Filter")),
                            S4(A("CONS"), K(A("COMP")),
                               K(A("theta:member")),
                               S4(A("CONS"), K(A("CONS")), K(A("id")),
                                  S3(A("CONS"), K(A("CONST")),
                                     A("system:cls_owned")))))),
                      A("system:cls_plain_heads"))),
                A("system:cls_agg_heads"))),
          A("system:cls_keyspanned")))),

DEF("system:cls_sweep",
    S3(A("COMP"), A("theta:setminus"),
       S3(A("CONS"), A("system:cls_candidates"),
          A("system:cls_selfsup")))),

DEF("system:cls_dred",
    S3(A("COMP"), A("apply"),
       S3(A("CONS"),
          S3(A("COMP"), A("apply"),
             S3(A("CONS"), K(A("theta:Filter")),
                S4(A("CONS"), K(A("COMP")), K(A("theta:member")),
                   S4(A("CONS"), K(A("CONS")), K(A("id")),
                      S3(A("CONS"), K(A("CONST")),
                         A("system:cls_selfsup")))))),
          A("system:cls_candidates")))),

DEF("system:cls_aggwhole",
    S3(A("COMP"), A("apply"),
       S3(A("CONS"),
          S3(A("COMP"), A("apply"),
             S3(A("CONS"), K(A("theta:Filter")),
                S4(A("CONS"), K(A("COMP")), K(A("theta:member")),
                   S4(A("CONS"), K(A("CONS")), K(A("id")),
                      S3(A("CONS"), K(A("CONST")),
                         A("system:cls_owned")))))),
          A("system:cls_agg_heads")))),

DEF("system:classify_heads",
    S3(A("COMP"), A("theta:flatten"),
       S6(A("CONS"),
          S3(A("COMP"),
             S2(A("ALPHA"), S3(A("CONS"), K(A("agg")), A("id"))),
             A("system:cls_agg_heads")),
          S3(A("COMP"),
             S2(A("ALPHA"), S3(A("CONS"), K(A("keyed")), A("id"))),
             A("system:cls_keyed")),
          S3(A("COMP"),
             S2(A("ALPHA"), S3(A("CONS"), K(A("sweep")), A("id"))),
             A("system:cls_sweep")),
          S3(A("COMP"),
             S2(A("ALPHA"), S3(A("CONS"), K(A("dred")), A("id"))),
             A("system:cls_dred")),
          S3(A("COMP"),
             S2(A("ALPHA"), S3(A("CONS"), K(A("aggwhole")), A("id"))),
             A("system:cls_aggwhole"))))),

"THE COMPILER'S HANDLER TRANSLATORS AS DATA (2026-07-09, #18 pilot; doctrine: even the compiler is canonized — DEFS override provides performance, lambdas provide the execution lattice). A translator maps ⟨groups, known, mod⟩ -> ⟨asserts, objs⟩: the (cell, fact) rows to store plus the (name, obj) defs to install; Stage-1 (regex text->groups) stays the host SEED because text->atom is the informal boundary. system:h_objectification is the pilot — an objectification reading's two capture groups ⟨association, entity⟩ give the entity its ObjectType instance-of and the objectification link to its association: ⟨⟨⟨instanceOf,⟨entity,ObjectType⟩⟩,⟨objectification,⟨entity,association⟩⟩⟩, phi⟩. Host _h_objectification is the certified-equal native override (test_hobj_canon.py twins them; the host stays native so compiles keep their speed).",

DEF("system:h_objectification",
    S3(A("CONS"), S3(A("CONS"), S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), K(A("ObjectType")))), S3(A("CONS"), K(A("objectification")), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), S3(A("COMP"), N(1), N(1))))), K(PHI()))),

"THE SM HANDLER TRANSLATORS AS DATA (2026-07-10, #18): six state-machine reading handlers, each a thin delegation to the canonical system:sm_rows row object over the four-tuple ⟨verb, head, group1, group2⟩ — the verb is the grammar's own recognizer token (constant per handler), the head splits the shared 'emits' verb between Transition (Mealy) and Status (Moore). A translator maps ⟨groups, known, mod⟩ -> ⟨rows, phi⟩ (no objs). Hosts _h_sm_def/initial/from/to/emit/moore stay the certified-equal native overrides (test_sm_handler_canon twins them). Trigger and guard canonize the same way (2026-07-10): the compiler's _COOK boundary resolves their clause group (reading -> fact-type id through known context — Stage-1's step, exactly as this doctrine assigns it) BEFORE dispatch, so system:h_sm_trigger / system:h_sm_guard are the same pure sm_rows shape and the hosts stay the certified-equal overrides (test_sm_handler_canon).",

DEF("system:h_sm_def", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("is for Noun")), K(A("State Machine Definition")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_initial", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("is initial in State Machine Definition")), K(A("Status")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_from", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("is from Status")), K(A("Transition")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_to", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("is to Status")), K(A("Transition")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_emit", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("emits")), K(A("Transition")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_moore", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("emits")), K(A("Status")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_trigger", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("is triggered by Fact Type")), K(A("Transition")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

DEF("system:h_sm_guard", S3(A("CONS"), S3(A("COMP"), A("system:sm_rows"), S5(A("CONS"), K(A("is guarded by Fact Type")), K(A("Transition")), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))), K(PHI()))),

"THE RING-CONSTRAINT READING TRANSLATOR AS DATA (2026-07-10, #18): the first CONSTRAINT-family handler, and the first with a non-phi objs half. The _COOK boundary resolves the reading (Stage-1's step): groups arrive as ⟨decl_rows, cid, kind_tag, ft, builder_name⟩. The translator appends the constraint row to the declaration rows (apndr) and emits ONE obj ⟨cid, (builder_name : ⟨1,2⟩)⟩ — the constraint OBJECT is the canonical builder applied through DEFS via the apply prim (the C.ring_* hosts are already exactly that application), so even the objs half is canon-valued. Host _h_ring is the certified-equal override (test_ring_canon, extensional on the obj).",

DEF("system:h_ring",
    S3(A("CONS"),
       S3(A("COMP"), A("apndr"),
          S3(A("CONS"), S3(A("COMP"), N(1), N(1)),
             S3(A("CONS"), K(A("constraint")),
                S5(A("CONS"), S3(A("COMP"), N(2), N(1)), S3(A("COMP"), N(3), N(1)), S3(A("COMP"), N(4), N(1)), N(3))))),
       S2(A("CONS"),
          S3(A("CONS"), S3(A("COMP"), N(2), N(1)),
             S3(A("COMP"), A("apply"),
                S3(A("CONS"), S3(A("COMP"), N(5), N(1)), K(S2(N(1), N(2))))))))),

"THE GENERIC CONSTRAINT TRANSLATOR AS DATA (2026-07-10, #18): system:h_crows — ONE canon body the whole constraint family shares; each reading kind reduces to a Stage-1 COOK. Cooked groups ⟨decl_rows, mid, obj_specs⟩: decl rows pass through; each mid entry is ⟨c, tail⟩ (a constraint-row tail completed with the statement's modality — apndr over distr:⟨mid, mod⟩, the mod riding into the mapped elements because FP maps see only their element) or ⟨w, row⟩ (a whole row, passed as data); each obj spec ⟨cid, builder, operand⟩ becomes ⟨cid, (builder : operand)⟩ through the apply prim — _scoped's own application form, so the scoped/uniqueness/range builders all ride one mapper. OPTIONALITY IS THE EMPTY SEQUENCE: cat and ALPHA are identity on phi, so conditional families (uniqueness's exactly-one mandatory rider) are just MORE ELEMENTS from the cook — no COND anywhere. h_uniqueness and h_mandatory are name aliases of this one body; hosts stay the certified-equal overrides (test_crows_canon).",

DEF("system:h_crows",
    S3(A("CONS"),
       S3(A("COMP"), A("cat"),
          S3(A("CONS"), S3(A("COMP"), N(1), N(1)),
             S3(A("COMP"),
                S2(A("ALPHA"), S4(A("COND"),
                    S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("c")))),
                    S3(A("CONS"), K(A("constraint")), S3(A("COMP"), A("apndr"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), N(2)))),
                    S3(A("COMP"), N(2), N(1)))),
                S3(A("COMP"), A("distr"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), N(3)))))),
       S3(A("COMP"),
          S2(A("ALPHA"), S4(A("COND"),
              S3(A("COMP"), A("null"), N(3)),
              S3(A("CONS"), N(1), N(2)),
              S3(A("CONS"), N(1), S3(A("COMP"), A("apply"), S3(A("CONS"), N(2), N(3)))))),
          S3(A("COMP"), N(3), N(1))))),

DEF("system:h_uniqueness", A("system:h_crows")),

DEF("system:h_mandatory", A("system:h_crows")),

DEF("system:h_neg_uniqueness", A("system:h_crows")),

DEF("system:h_neg_mandatory", A("system:h_crows")),

DEF("system:h_for_each_mandatory", A("system:h_crows")),

DEF("system:h_inverse_uc", A("system:h_crows")),

DEF("system:h_spanning_uc", A("system:h_crows")),

DEF("system:h_spanning_uc2", A("system:h_crows")),

DEF("system:h_negation", A("system:h_crows")),

DEF("system:h_subtype_of", A("system:h_crows")),

DEF("system:h_fact_type_reading", A("system:h_crows")),

DEF("system:h_derivation_rule", A("system:h_crows")),

DEF("system:h_class_rule", A("system:h_crows")),

"THE TWO-MODE OBJ MAPPER + THE SET-COMPARISON FAMILY (2026-07-10, #18): h_crows' obj mapper gained the NULLARY mode — an EMPTY operand means the builder takes no arguments, and the emitted object is THE NAME ATOM ITSELF, resolved through DEFS at use (an atom in operator position is rho(name): the universal interface IS the reference; the host override resolves the same table eagerly, certified extensionally). With it the set-comparison family (set_comparison, disjunctive_mandatory, equality, neg_pair) rides h_crows: cs_rows answers the A-row and attach rows as before, and the boundary specs each attach's builder ⟨cid, name, operand⟩ — scoped_* with their operands, the top-level exclusion/exclusive_or/inclusive_or as nullary names.",

DEF("system:h_set_comparison", A("system:h_crows")),

DEF("system:h_disjunctive_mandatory", A("system:h_crows")),

DEF("system:h_equality", A("system:h_crows")),

DEF("system:h_neg_pair", A("system:h_crows")),

DEF("system:h_subset_trailing", A("system:h_crows")),

"THE RULE-FORM READING TRANSLATORS (2026-07-10, #18): rule_if and rule_iff ride h_crows — the WHOLE body parse (clause split, column map, comparators-as-filter-trees, coercion aliases, negation groups, the aggregate extraction, the head shape incl. skolem existentials) is _cook_rule_if at the Stage-1 boundary, and every compiled object is an obj spec through DEFS: ⟨cid, system:compile_rule, ⟨atoms, head, filters⟩⟩ plus one system:compile_rule_delta spec per atom seat (the semi-naive variants), system:compile_agg_rule for the aggregate form, system:compile_rule_neg for the stratified negation form. Filters are the cmp_filter DATA TREES (⟨COMP, op, ⟨CONS, col, ⟨CONST, lit⟩⟩⟩ / ⟨COMP, op, ⟨CONS, col, col2⟩⟩ — what the builders construct anyway), so the specs stay pure data and the apply prim rebuilds the identical objects. rule_iff's storage marker resolves to the derivation kind in its cook (_MARKER_KIND — the old delegation, moved whole to the boundary). Hosts _h_rule_if/_h_rule_iff are the certified-equal crows overrides (test_rule_if_canon twins rows and objects, structurally and extensionally).",

DEF("system:h_rule_if", A("system:h_crows")),

DEF("system:h_rule_iff", A("system:h_crows")),

"THE VALUE-CONSTRAINT READING TRANSLATOR AS DATA (2026-07-10, #18): cooked groups ⟨name, spec, cid, builder_name, operand⟩ — the spec parse (the VALUE_SPECS pattern table + the enumeration fallback) is the string boundary, and the chosen canonical builder (constraints:value_range / constraints:value_enumeration) rides as a NAME the translator applies through DEFS. Two rows (the valueConstraint reading row keeping the spec text + the constraint row on the value type's own cell) and one obj ⟨cid, (builder : operand)⟩. Host _h_value_constraint is the certified-equal override (test_value_constraint_canon, extensional on the obj).",

DEF("system:h_value_constraint",
    S3(A("CONS"),
       S3(A("CONS"),
          S3(A("CONS"), K(A("valueConstraint")), S4(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)), N(3))),
          S3(A("CONS"), K(A("constraint")), S5(A("CONS"), S3(A("COMP"), N(3), N(1)), K(A("value")), S3(A("COMP"), N(1), N(1)), N(3)))),
       S2(A("CONS"),
          S3(A("CONS"), S3(A("COMP"), N(3), N(1)),
             S3(A("COMP"), A("apply"),
                S3(A("CONS"), S3(A("COMP"), N(4), N(1)), S3(A("COMP"), N(5), N(1)))))))),

"THE FREQUENCY-CONSTRAINT READING TRANSLATOR AS DATA (2026-07-10, #18): the second constraint-family handler. Cooked groups ⟨cid, ft, roles, builder_operand⟩ — the reading resolution, role-name lookup, and bound encoding (absent bound = the empty sequence, the canonical optionality from constraints:frequency's own contract) are Stage-1's. The translator prepends the constraint row (apndl) to the spans rows — ONE ROW PER ROLE, the mapped family α(⟨spans, id⟩) over distl:⟨cid, roles⟩ — and emits ⟨cid, (constraints:frequency : operand)⟩. Host _h_frequency is the certified-equal override (test_frequency_canon, extensional on the obj).",

DEF("system:h_frequency",
    S3(A("CONS"),
       S3(A("COMP"), A("apndl"),
          S3(A("CONS"),
             S3(A("CONS"), K(A("constraint")),
                S5(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("frequency")), S3(A("COMP"), N(2), N(1)), N(3))),
             S3(A("COMP"),
                S2(A("ALPHA"), S3(A("CONS"), K(A("spans")), A("id"))),
                S3(A("COMP"), A("distl"),
                   S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(3), N(1))))))),
       S2(A("CONS"),
          S3(A("CONS"), S3(A("COMP"), N(1), N(1)),
             S3(A("COMP"), A("apply"),
                S3(A("CONS"), K(A("constraints:frequency")), S3(A("COMP"), N(4), N(1)))))))),

"A REFERENCE-SCHEME READING TRANSLATOR AS DATA (2026-07-10, #18): the entity g0 is an ObjectType, its identifying value g1 a ValueType, and refScheme links them — three constant-tag rows from the two groups, the same pure ⟨groups, known, mod⟩ -> ⟨rows, phi⟩ shape as h_objectification. Host _h_ref_scheme stays the certified-equal native override (test_ref_scheme_canon).",

DEF("system:h_ref_scheme", S3(A("CONS"), S4(A("CONS"), S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("ObjectType")))), S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), K(A("ValueType")))), S3(A("CONS"), K(A("refScheme")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1))))), K(PHI()))),

"THE METADATA READING TRANSLATORS AS DATA (2026-07-10, #18): the data_type and ref_mode readings each emit ONE row into their own cell — the single capture group's value — the pure ⟨groups, known, mod⟩ -> ⟨⟨⟨cell, ⟨g0⟩⟩⟩, phi⟩ shape. Host _h_meta is the certified-equal factory (test_meta_handler_canon twins both instances).",

DEF("system:h_meta_data_type", S3(A("CONS"), S2(A("CONS"), S3(A("CONS"), K(A("data_type")), S2(A("CONS"), S3(A("COMP"), N(1), N(1))))), K(PHI()))),

DEF("system:h_meta_ref_mode", S3(A("CONS"), S2(A("CONS"), S3(A("CONS"), K(A("ref_mode")), S2(A("CONS"), S3(A("COMP"), N(1), N(1))))), K(PHI()))),

"THE ENTITY-TYPE READING TRANSLATOR AS DATA (2026-07-10, #18): the FIRST conditional-class handler. Stage-1 now splits 'Name(.RefMode)' into two groups g0=name, g1=refmode (empty when absent); the entity gets its ObjectType instance-of, and refMode(g0,g1) rides ONLY when g1 is non-empty. COND(eq(g1,''), the-single-row, the-two-rows) over the pure ⟨groups, known, mod⟩ -> ⟨rows, phi⟩ shape. Host _h_entity is the certified-equal override (test_entity_canon).",

DEF("system:h_entity",
    S3(A("CONS"),
       S4(A("COND"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), K(A("")))),
          S2(A("CONS"), S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("ObjectType"))))),
          S3(A("CONS"),
             S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("ObjectType")))),
             S3(A("CONS"), K(A("refMode")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))))),
       K(PHI()))),

"THE VALUE-TYPE READING TRANSLATOR AS DATA (2026-07-10, #18): system:h_entity's twin bar the kind tag — the same conditional shape, COND(eq(g1,''), single-row, two-rows), emitting ValueType. Host _h_value is the certified-equal override (test_value_canon).",

DEF("system:h_value",
    S3(A("CONS"),
       S4(A("COND"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), K(A("")))),
          S2(A("CONS"), S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("ValueType"))))),
          S3(A("CONS"),
             S3(A("CONS"), K(A("instanceOf")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), K(A("ValueType")))),
             S3(A("CONS"), K(A("refMode")), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1)))))),
       K(PHI()))),

"THE PASS ORDER AND ROUND BOUND AS DATA (2026-07-08, scheduler-as-data second face): constants of doctrine, materialized as the passOrder and passBound cells beside passHeads; hosts dispatch their native pass bodies by the cell and fall back to the same literals when a store lacks it. The positive closure stays OUTSIDE the ordered passes: it is the floor the strata stand on.",

DEF("system:pass_order",
    K(S4(S2(N(1), A("agg")), S2(N(2), A("keyed")),
         S2(N(3), A("sweep")), S2(N(4), A("dred"))))),

DEF("system:pass_bound",
    K(S1(S1(N(12))))),

"THE VIEW PROJECTIONS (2026-07-08, the ui re-authoring's first slice — the binding doctrine): view(entity) = project(P, entity), Theorem 4 extended from actions to whole views as PURE defs answering abstract element trees as VALUES, never stored facts. system:view_menu over ⟨status, sm-triples⟩ answers ⟨menu, ⟨⟨button, event, to⟩…⟩⟩ — one button per transition available FROM the status; the element vocabulary is the Component registry's Role names, so select_component resolves nodes to toolkit implementations and DEFS-registered render functions draw them.",

DEF("system:view_menu",
    S3(A("CONS"),
       K(A("menu")),
       S3(A("COMP"),
          S2(A("ALPHA"),
             S4(A("CONS"), K(A("button")), N(2), N(3))),
          S3(A("COMP"), A("apply"),
             S3(A("CONS"),
                S3(A("COMP"), A("apply"),
                   S3(A("CONS"), K(A("theta:Filter")),
                      S4(A("CONS"), K(A("COMP")), K(A("eq")),
                         S4(A("CONS"), K(A("CONS")), K(N(1)),
                            S3(A("CONS"), K(A("CONST")), N(1)))))),
                N(2)))))),

DEF("system:view_detail",
    S3(A("CONS"),
       K(A("detail")),
       S2(A("ALPHA"),
          S4(A("CONS"), K(A("field")), N(1), N(2))))),

DEF("system:view_list",
    S3(A("CONS"),
       K(A("list")),
       S2(A("ALPHA"),
          S4(A("CONS"), K(A("item")), N(1), N(2))))),

"THE ENTRY VIEW (2026-07-08, the abstract UI's create perspective — iFactr's SubmitKey pattern): system:view_entry over the ev_cols classification answers ⟨entry, ⟨⟨input, ft, name, kind⟩…⟩⟩ — one input node per classified column, the fact type ITSELF the node's SubmitKey (a control binds to the fact's function, never to app code). The id input is the container's (eq. (sys): identity addresses the entity; it is not a column).",

DEF("system:view_entry",
    S3(A("CONS"),
       K(A("entry")),
       S2(A("ALPHA"),
          S5(A("CONS"), K(A("input")), N(1), N(4), N(2))))),

"THE RENDER AS CANON (2026-07-08, the doctrine correction: meaning in canon, boundary for transduction only): system:render_html is the definition of record turning the view trees into semantic html — the kind dispatch, the per-row element construction, and the joins are ALL combinator structure here; the ONLY boundary piece is escape_html (byte-level entity substitution, the lex family). Host render functions are certified-equal performance overrides. The else branch bottoms via tl-of-an-atom (a non-tree input answers no html).",

DEF("system:render_html",
    S4(A("COND"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), N(1), K(A("menu")))),
       S3(A("COMP"), A("implode"),
          S3(A("CONS"), K(A("")),
             S3(A("COMP"), A("cat"),
                S3(A("CONS"),
                   S3(A("COMP"), A("cat"),
                      S3(A("CONS"),
                         K(S1(A("<nav class=\"menu\">"))),
                         S3(A("COMP"),
                            S2(A("ALPHA"),
                               S3(A("COMP"), A("implode"),
                                  S3(A("CONS"), K(A("")),
                                     S8(A("CONS"),
                                        K(A("<button name=\"")),
                                        S3(A("COMP"), A("escape_html"), N(2)),
