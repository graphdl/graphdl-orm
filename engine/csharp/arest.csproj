<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Arestlam</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- the WPF show renderer is its OWN project: without this exclusion
       the kernel's default glob compiles show/obj's GENERATED
       AssemblyInfo alongside its own (duplicate-attribute CS0579 —
       found 2026-07-09 when the parity test broke after show landed) -->
  <ItemGroup>
    <Compile Remove="show/**" />
    <EmbeddedResource Remove="show/**" />
    <None Remove="show/**" />
  </ItemGroup>

  <!-- The include! equivalent: each shared intersection file becomes the body
       of a varargs method call by BYTE CONCATENATION (prefix + file + suffix),
       never parsing. The same bytes CPython execs and rustc tokenizes. -->
  <Target Name="WrapCanon" BeforeTargets="CoreCompile"
          Inputs="../shared/theta.canon;../shared/constraints.canon;../shared/ast.canon;../shared/system.canon;../shared/scenarios.canon"
          Outputs="$(IntermediateOutputPath)Canon.g.cs">
    <PropertyGroup>
      <CanonTheta>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../shared/theta.canon'))</CanonTheta>
      <CanonConstraints>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../shared/constraints.canon'))</CanonConstraints>
      <CanonAst>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../shared/ast.canon'))</CanonAst>
      <CanonSystem>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../shared/system.canon'))</CanonSystem>
      <CanonScenarios>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../shared/scenarios.canon'))</CanonScenarios>
      <CanonWrapped>namespace Arestlam%3B

static partial class Canon
{
    static object LoadTheta() =&gt; T
$(CanonTheta)
%3B

    static object LoadConstraints() =&gt; T
$(CanonConstraints)
%3B

    static object LoadAst() =&gt; T
$(CanonAst)
%3B

    static object LoadSystem() =&gt; T
$(CanonSystem)
%3B

    internal static object LoadScenarios() =&gt; T
$(CanonScenarios)
%3B
}
</CanonWrapped>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Canon.g.cs"
                      Lines="$(CanonWrapped)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Canon.g.cs" />
    </ItemGroup>
  </Target>

</Project>
