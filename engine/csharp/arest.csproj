<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Arestlam</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- the WPF show renderer is its OWN project: without this exclusion
       the kernel's default glob compiles show/obj's GENERATED
       AssemblyInfo alongside its own (duplicate-attribute CS0579 —
       found 2026-07-09 when the parity test broke after show landed) -->
  <ItemGroup>
    <Compile Remove="show/**" />
    <EmbeddedResource Remove="show/**" />
    <None Remove="show/**" />
  </ItemGroup>

  <!-- Spec v3 (2026-07-13): the canon boots from shared/canon.store.json
       through StoreCanon.cs (a store loader and a mu); the WrapCanon
       byte-wrap target, the generated Canon.g.cs, and Vocabulary.cs are
       retired. -->

</Project>
