# Local-dev env for ui.do (copy to .env.local; .env.local is gitignored).
# See LOCAL-DEV.md for the full recipe.

# Point the providers at the SAME-ORIGIN proxied path. vite.config.ts
# proxies /arest and /api to the local Wrangler worker, so the browser
# never makes a cross-origin (CORS) request. Do NOT put a full
# http://127.0.0.1:8788 URL here — that would re-introduce CORS.
VITE_AREST_BASE_URL=/arest

# Render the support.auto.dev app locally without faking DNS. This makes
# useBranding resolve the support branding (app slug 'support.do',
# support-domain noun-scope filter) even on localhost:5174.
VITE_AREST_HOST=support.auto.dev
